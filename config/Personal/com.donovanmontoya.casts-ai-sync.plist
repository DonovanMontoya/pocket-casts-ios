<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mondays and Thursdays at 7:00. If the Mac is asleep then, launchd runs it on wake.
     Install with config/Personal/install-sync-schedule.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.donovanmontoya.casts-ai-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__SCRIPT__</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <!-- Not "Background": that confines the build to efficiency cores and throttled
       I/O, which took a full build to 45 minutes. The script runs xcodebuild under nice. -->
  <key>ProcessType</key>
  <string>Standard</string>
</dict>
</plist>
